<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookDecryptor.MainPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Book Decryptor" FontSize="28" FontAttributes="Bold" />

            <Label Text="Decrypt a book file or XML using the same scheme as the BookViewer app."
                   Style="{StaticResource Caption}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="FilePathEntry" Grid.Column="0" IsReadOnly="True"
                       Placeholder="No file selected"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                <Button Grid.Column="1" Text="Pick File" Clicked="OnPickClicked"
                        BackgroundColor="{StaticResource Accent}" TextColor="White" />
            </Grid>

            <Label Text="Encryption scheme" FontAttributes="Bold" />
            <Picker x:Name="SchemePicker" SelectedIndex="0">
                <Picker.Items>
                    <x:String>BookViewer — key from filename</x:String>
                    <x:String>BookViewer — key from book UID</x:String>
                    <x:String>BookViewer — key from step number (strict)</x:String>
                    <x:String>Raw Caesar shift on ENCRYPT_MAP</x:String>
                    <x:String>XOR with numeric key</x:String>
                    <x:String>Base64 only (no cipher)</x:String>
                </Picker.Items>
            </Picker>

            <VerticalStackLayout x:Name="KeyPanel" Spacing="6">
                <Label x:Name="KeyLabel" Text="Key / Book UID" FontAttributes="Bold" />
                <Entry x:Name="KeyEntry" Placeholder="e.g. 3827 or 12345" Keyboard="Numeric"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                <Label x:Name="KeyHint" Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <Button Text="Decrypt" Clicked="OnDecryptClicked"
                    BackgroundColor="{StaticResource Accent}" TextColor="White"
                    HeightRequest="48" CornerRadius="10" />

            <Label Text="Result ^(first 400 chars^)" FontAttributes="Bold" />
            <Frame Padding="12" CornerRadius="8"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                   BorderColor="Transparent" HasShadow="False">
                <Label x:Name="PreviewLabel" LineBreakMode="WordWrap" FontSize="12" FontFamily="monospace" />
            </Frame>

            <Button x:Name="SaveButton" Text="Save decrypted file" Clicked="OnSaveClicked"
                    IsEnabled="False"
                    BackgroundColor="{StaticResource Accent}" TextColor="White"
                    HeightRequest="44" CornerRadius="10" />

            <Label x:Name="StatusLabel" Style="{StaticResource Caption}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
